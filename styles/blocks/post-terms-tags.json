{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"slug": "tags",
	"title": "Tags",
	"blockTypes": [ "core/post-terms" ],
	"styles": {
		"css": "&{display:flex;flex-wrap:wrap;gap:0.5rem;} & .wp-block-post-terms__separator{display:none;} & a{display:inline-block;padding:0.4rem 0.95rem;border:1px solid var(--wp--preset--color--line);border-radius:var(--wp--preset--border-radius--pill);text-transform:none;letter-spacing:0;font-family:var(--wp--preset--font-family--geist);font-size:var(--wp--preset--font-size--small);color:var(--wp--preset--color--primary);} & a:hover{border-color:var(--wp--preset--color--primary);}"
	}
}
