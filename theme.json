				}
			},
			"core/image": {
				"border": {
					"radius": "var:preset|border-radius|small"
				}
			},
			"core/list": {
				"css": "& li{margin-top:0.4em;}"
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "400"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|secondary"
							}
