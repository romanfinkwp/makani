					}
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontFamily": "var:preset|font-family|geist-mono",
					"fontSize": "var:preset|font-size|tiny",
					"textTransform": "uppercase"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontFamily": "var:preset|font-family|geist-mono",
